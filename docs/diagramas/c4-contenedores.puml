@startuml
!include <C4/C4_Container>

LAYOUT_WITH_LEGEND()

title Diagrama C4 - Nivel 2: Contenedores (ImageViewer)

Person(usuario, "Usuario", "Usuario final de la aplicación.")

System_Boundary(c1, "Límite del Sistema ImageViewer") {
    Container(ui, "Interfaz Gráfica (View)", "Java Swing, AWT", "Renderiza la ventana, la barra de herramientas, el lienzo escalado y captura las acciones del usuario.")
    Container(presenter, "Presentador (Presenter)", "Java 17", "Orquesta la lógica de presentación, gestiona eventos y sincroniza el modelo con la vista.")
    Container(model, "Modelo de Datos (Model)", "Java 17", "Mantiene en memoria el estado de la imagen actual, la lista ordenada de navegación y los índices.")
    Container(service, "Servicio de Carga (Service)", "Java ImageIO / NIO", "Valida extensiones, escanea directorios y decodifica imágenes en memoria.")
}

System_Ext(fileSystem, "Sistema de Archivos Local", "Disco del SO", "Almacena los archivos físicos de imágenes en formatos compatibles.")

Rel(usuario, ui, "Interactúa con botones y diálogos", "Swing GUI")
Rel(ui, presenter, "Delega eventos de usuario (abrir, navegar)", "Llamadas a métodos")
Rel(presenter, ui, "Instruye qué mostrar y habilita controles", "ImageView (Passive View)")
Rel(presenter, model, "Consulta y actualiza estado de navegación", "Llamadas a métodos")
Rel(presenter, service, "Solicita carga de imágenes y lista de archivos", "Llamadas a métodos")
Rel(service, fileSystem, "Lee bytes de archivos e inspecciona carpetas", "File I/O")

@enduml